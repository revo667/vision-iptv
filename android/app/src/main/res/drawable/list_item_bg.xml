<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#808B5CF6" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="@color/accent_soft" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#558B5CF6" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#808B5CF6" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="@color/accent_soft" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /></shape></item>
</selector>
