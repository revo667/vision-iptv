<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="14dp" /><stroke android:width="2dp" android:color="#FFEDE9FE" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#26FFFFFF" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#33FFFFFF" /></shape>
    </item>
</selector>
