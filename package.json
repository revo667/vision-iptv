{
  "name": "vision-iptv",
  "productName": "Vision",
  "version": "1.0.0",
  "description": "Xtream Codes uyumlu modern IPTV oynatıcı (macOS, Windows, Android / Android TV)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip --arm64",
    "dist:win": "electron-builder --win nsis --x64",
    "android": "cd android && ./gradlew assembleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:icons": "python3 build/make_android_icons.py"
  },
  "build": {
    "appId": "com.revo667.vision",
    "productName": "Vision",
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "media-probe.js",
      "updater.js",
      "renderer/**/*",
      "!renderer/**/.DS_Store",
      "node_modules/hls.js/dist/hls.min.js",
      "node_modules/mpegts.js/dist/mpegts.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Vision-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "./build/adhoc-sign.js",
    "dmg": {
      "title": "Vision",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Vision-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Vision"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "revo667",
        "repo": "vision-iptv",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/revo667/vision-iptv.git"
  }
}
